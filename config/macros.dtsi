vim_save: vim_save {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&kp ESC &kp COLON &kp W &kp ENTER>;
};
vim_save_quit: vim_save_quit {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings = <&kp ESC &kp COLON &kp W &kp Q &kp ENTER>;
};
// Specials
special_grave: special_grave {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
        = <&macro_press &kp RALT>
        ,<&macro_tap &kp GRAVE>
        ,<&macro_release &kp RALT>
        ;
};
special_aigu: special_aigu {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
        = <&macro_press &kp RALT>
        ,<&macro_tap &kp SINGLE_QUOTE>
