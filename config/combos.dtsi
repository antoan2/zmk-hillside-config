// The famous only left hand
#ifdef COMBO_KEYS_COPY
COMBO(cut, &kp LC(X), COMBO_KEYS_COPY, BASE_L, DEFAULT_LEFT_TIMEOUT)
#endif

#ifdef COMBO_KEYS_CUT
COMBO(copy, &kp LC(C), COMBO_KEYS_CUT, BASE_L, DEFAULT_LEFT_TIMEOUT)
#endif

#ifdef COMBO_KEYS_PASTE
COMBO(paste, &kp LC(V), COMBO_KEYS_PASTE, BASE_L, DEFAULT_LEFT_TIMEOUT)
#endif

#ifdef COMBO_KEYS_PASTE_SHIFT
COMBO(shift_paste, &kp LC(LS(V)), COMBO_KEYS_PASTE_SHIFT, BASE_L, DEFAULT_LEFT_TIMEOUT)
#endif

#ifdef COMBO_KEYS_ENTER
COMBO(enter, &kp ENTER, COMBO_KEYS_ENTER, BASE_L, DEFAULT_LEFT_TIMEOUT)
#endif

#ifdef COMBO_KEYS_ENTER_CTRL
COMBO(enter_ctrl, &kp LC(ENTER), COMBO_KEYS_ENTER_CTRL, BASE_L, DEFAULT_LEFT_TIMEOUT)
#endif

#ifdef COMBO_KEYS_SPECIAL_LAYER
COMBO(special_layer, &special_layer_once, COMBO_KEYS_SPECIAL_LAYER, BASE_L, DEFAULT_TIMEOUT)
#endif