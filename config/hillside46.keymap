/*
 * Hillside 46 — Ultra-Minimal Test Keymap
 *
 * LEFT SIDE: BT controls + output toggle + bootloader + "A" key to test
 * RIGHT SIDE: Just "B" key to test (proves halves are communicating)
 *
 * You do NOT need to hold any layer key. Everything is on layer 0.
 *
 * Hillside 46 layout: 3 rows of 6 keys per side (12 per row)
 *   + 1 extra key per side on row 3 (the inner column)
 *   + 4 thumb keys per side
 * Total: 46 keys
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Test";
            bindings = <
// ╭──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────╮                    ╭──────────────┬──────────────┬──────────────┬──────────────┬──────────────┬──────────────╮
// │  Row 0       │              │              │              │              │              │                    │              │              │              │              │              │              │
     &bt BT_SEL 0  &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR                         &kp B          &none          &none          &none          &none          &none
// ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤                    ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
// │  Row 1       │              │              │              │              │              │                    │              │              │              │              │              │              │
     &out OUT_USB   &out OUT_BLE  &out OUT_TOG   &none          &none          &none                              &none          &none          &none          &none          &none          &none
// ├──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼────────╮  ╭────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┼──────────────┤
// │  Row 2       │              │              │              │              │              │ Extra  │  │ Extra  │              │              │              │              │              │              │
     &bootloader    &sys_reset    &none          &none          &none          &none          &none       &none    &none          &none          &none          &none          &none       &bootloader
// ╰──────────────┴──────────────┼──────────────┼──────────────┼──────────────┼──────────────╯        ╰────────  ╰──────────────┼──────────────┼──────────────┼──────────────┼──────────────┴──────────────╯
// │  Thumbs      │              │              │              │                                                                │              │              │              │              │
                                   &none          &none          &kp A          &none                              &none          &kp B          &none          &none
//                                ╰──────────────┴──────────────┴──────────────┴──────────────╯                   ╰──────────────┴──────────────┴──────────────┴──────────────╯
            >;
        };
    };
};