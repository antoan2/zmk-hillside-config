        };

        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        bindings = <

&trans      &kp Q         &kp W         &kp E          &kp R           &kp T                                                                             &kp Y  &kp U           &kp I          &kp O         &kp P             &trans
&trans  &hmrl LGUI A  &hmrl LALT S  &hmrl LCTRL D  &hmsl LSHIFT F  &kp G                                                                             &kp H  &hmsr RSHIFT J  &hmrr RCTRL K  &hmrr LALT L  &ht_spe_mou         &trans
&trans      &kp Z         &kp X         &kp C          &kp V           &kp B        &trans                                                 &trans        &kp N  &kp M           &kp COMMA      &kp DOT       &kp SLASH         &trans
                                                                  &kp DELETE  &thumb NUM_L TAB     &thumb SYM_L BACKSPACE  &trans    &trans  &space NAV_L SPACE  &kp ENTER  &kp ESC 
                        >;
			
                        sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
                };
		
                 nav_layer {
                         bindings = <
 &trans  &trans             &kp HOME        &kp UP          &kp END           &trans                                                &trans  &kp K_PLAY_PAUSE   &kp K_MUTE      &kp K_VOL_UP    &kp K_VOL_DN     &trans
 &trans  &trans             &kp LEFT        &kp DOWN        &kp RIGHT         &trans                                                &trans  &kp RSHIFT         &kp RCTRL       &kp LALT        &kp RGUI         &trans
 &trans  &trans             &kp PAGE_UP     &trans          &kp PAGE_DOWN     &trans       &trans                    &trans         &trans  &trans           &trans          &trans          &kp LS(RGUI)     &trans
                                                                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans 
                         >;
 		
                         sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                 };

                 sym_layer {
                        bindings = <
&trans  &kp TILDE  &kp AT                &kp HASH                &kp DOLLAR        &kp PERCENT                                                  &kp CARET         &kp AMPS           &kp ASTRK                &kp QUESTION           &trans     &trans
&trans  &kp EXCL   &mt LCTRL LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp UNDERSCORE    &kp MINUS                                                    &kp PLUS          &kp EQUAL          &kp RIGHT_PARENTHESIS  &mt RCTRL RIGHT_BRACKET  &kp COLON  &trans
&trans  &kp GRAVE  &kp LEFT_BRACE        &trans                  &kp SINGLE_QUOTE  &kp LESS_THAN        &trans                    &trans        &kp GREATER_THAN  &kp DOUBLE_QUOTES  &kp BACKSLASH            &kp RIGHT_BRACE        &kp PIPE   &trans
                                                                                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
                        >;
			
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                 num_layer {
                        bindings = <
&trans       &bt BT_CLR_ALL  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2                                                           &kp PLUS   &ht_number_7_f7 F7 NUMBER_7  &ht_number_8_f8 F8 NUMBER_8  &ht_number_9_f9 F9 NUMBER_9  &trans        &kp F10
&trans       &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &trans                                                           &kp EQUAL  &ht_number_4_f4 F4 NUMBER_4  &ht_number_5_f5 F5 NUMBER_5  &ht_number_6_f6 F6 NUMBER_6  &trans        &kp F11
&trans &out OUT_BLE  &out OUT_USB  &out OUT_TOG  &sys_reset  &bootloader  &trans                               &trans        &kp MINUS  &ht_number_1_f1 F1 NUMBER_1  &ht_number_2_f2 F2 NUMBER_2  &ht_number_3_f3 F3 NUMBER_3  &trans        &kp F12
                                                     &trans  &trans  &trans  &trans    &kp COMMA  &kp NUMBER_0  &kp DOT  &trans
                        >;
			
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };

                 special_layer {
                        bindings = <
&trans  &special_e_aigu_twice  &ht_macro_e_aigu 0 0  &ht_macro_e_grave 0 0  &trans         &trans                                                        &trans        &ht_macro_u_grave 0 0  &trans          &trans          &trans  &trans
&trans  &ht_macro_a_grave 0 0  &ht_macro_e_trema 0 0     &ht_macro_e_hat 0 0   &kp LSHFT          &trans                                                        &trans        &ht_macro_u_hat 0 0    &ht_macro_i_hat 0 0  &ht_macro_o_hat 0 0  &trans  &trans
&trans  &ht_macro_a_hat 0 0    &trans                &mt LS(RA(COMMA)) RA(COMMA)     &special_aigu      &special_grave        &trans                    &trans        &special_hat  &special_trema    &trans          &trans          &trans  &trans         
                                                                                   &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
                        >;
			
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };
                 mouse_layer {
// ============================================================================
// DAEMON-CONTROLLED MOUSE LAYER
// ============================================================================
// Movement: F13-F16 (up/down/left/right) - no modifiers, daemon intercepts
// Mode modifiers (daemon-side): F17 = precision, F18 = scroll
//   Hold while moving to change speed/behavior - no ZMK layer switch needed
// Teleport: Ctrl+Shift+Alt + F13-F24 for 12 positions across 3 screens
//
// Left hand: ESDF movement, thumbs for mode modifiers
// Right hand: 
//   - Top row: Teleport top positions (S1-TL, S1-TR, S2-TL, S2-TR, S3-TL, S3-TR)
//   - Home row: Teleport bottom positions + Ctrl (for Ctrl+Click)
// Thumbs (right): Left Click, Right Click, Middle Click
                        bindings = <
&trans      &trans         &trans        &kp SIG_UP     &trans            &trans                                                                       &kp TP_S1_TL   &kp TP_S1_TR   &kp TP_S2_TL   &kp TP_S2_TR   &kp TP_S3_TL   &kp TP_S3_TR
&trans      &trans         &kp SIG_LEFT  &kp SIG_DOWN   &kp SIG_RIGHT     &trans                                                                       &trans         &mkp LCLK      &kp LCTRL      &mkp RCLK      &tog MOU_L     &trans
&trans      &trans         &trans        &trans         &trans            &trans        &trans                                        &trans           &kp TP_S1_BL   &kp TP_S1_BR   &kp TP_S2_BL   &kp TP_S2_BR   &kp TP_S3_BL   &kp TP_S3_BR
                                                       &trans  &trans  &trans  &trans                       &trans  &kp SIG_PRECISION &kp SIG_SCROLL  &mkp MCLK
                        >;
                        
                        sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
                };
        };
};
